# HTTP server port (default: 8080)
PORT=8080

# slog level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# PostgreSQL connection string used by `cmd/migrate` and (later) the server.
# Local example: postgres://postgres:postgres@localhost:5432/counail?sslmode=disable
# Supabase example: postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# Redis connection URL used by the worker queue (Phase 3+) and any cache helpers.
# Local example (via docker-compose.yml at repo root): redis://localhost:6379/0
# Upstash example: rediss://default:<token>@<host>:6379
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of Origin headers the API accepts from browsers (CORS).
# Default suits the Next.js dev server. Add staging/prod origins in production.
ALLOWED_ORIGINS=http://localhost:3000
